        // ==========================================
        // 5. TEMPO MÉDIO DE EXECUÇÃO POR ROBÔ
        // ==========================================
        function renderRobotsAvgTime(data) {
            const container = document.getElementById('robots-avg-time-list');
            const countBadge = document.getElementById('robots-avg-time-count');
            const fastestEl = document.getElementById('robot-avg-fastest');
            const slowestEl = document.getElementById('robot-avg-slowest');

            if (!container) return;

            // Agrupa execuções com duração por robô
            const byRobo = {};
            data.forEach(d => {
                if (!d.Robo) return;
                let dur = d.DuracaoVerificacaoEmMinutos != null ? parseFloat(d.DuracaoVerificacaoEmMinutos) : null;
                // Fallback caso venha nulo mas tenha DataInicio e DataFim
                if (dur == null && d.DataInicio && d.DataFim) {
                    const diffMs = new Date(d.DataFim) - new Date(d.DataInicio);
                    if (diffMs > 0) dur = diffMs / (1000 * 60);
                }

                if (!byRobo[d.Robo]) {
                    byRobo[d.Robo] = {
                        name: d.Robo,
                        durations: [],
                        totalExecs: 0
                    };
                }
                byRobo[d.Robo].totalExecs++;
                if (dur != null && !isNaN(dur) && dur >= 0) {
                    byRobo[d.Robo].durations.push(dur);
                }
            });

            const roboList = Object.values(byRobo);

            if (roboList.length === 0) {
                container.innerHTML = `
                    <div class="empty-state" style="padding:30px 10px;">
                        <div class="empty-state-icon"><i class="fas fa-hourglass-empty"></i></div>
                        <p>Nenhuma execução registrada no período.</p>
                        <span style="font-size:0.75rem; color:var(--text-muted); margin-top:4px;">Selecione outro período ou filtro de robô.</span>
                    </div>
                `;
                if (countBadge) countBadge.innerText = '0 robôs';
                if (fastestEl) fastestEl.innerText = '--';
                if (slowestEl) slowestEl.innerText = '--';
                return;
            }

            // Calcula métricas para cada robô
            const computedRobos = roboList.map(r => {
                const durs = r.durations;
                const avg = durs.length > 0 ? (durs.reduce((a, b) => a + b, 0) / durs.length) : 0;
                const min = durs.length > 0 ? Math.min(...durs) : 0;
                const max = durs.length > 0 ? Math.max(...durs) : 0;
                return {
                    name: r.name,
                    avg: avg,
                    min: min,
                    max: max,
                    count: r.totalExecs,
                    hasDurs: durs.length > 0
                };
            });

            // Ordena do mais rápido ao mais lento (tempo médio crescente)
            computedRobos.sort((a, b) => a.avg - b.avg);

            if (countBadge) countBadge.innerText = `${computedRobos.length} ${computedRobos.length === 1 ? 'robô' : 'robôs'}`;

            const formatDurationText = (val) => {
                if (val == null || isNaN(val) || val <= 0) return '0s';
                const totalSec = Math.round(val * 60);
                const m = Math.floor(totalSec / 60);
                const s = totalSec % 60;
                if (m === 0) return `${s}s`;
                return `${m}m ${s.toString().padStart(2, '0')}s`;
            };

            const validWithDurs = computedRobos.filter(r => r.hasDurs);
            if (validWithDurs.length > 0) {
                const fastest = validWithDurs[0];
                const slowest = validWithDurs[validWithDurs.length - 1];
                const cleanName = (n) => n.replace(/^Robo/i, '');
                if (fastestEl) fastestEl.innerText = `${formatDurationText(fastest.avg)} (${cleanName(fastest.name)})`;
                if (slowestEl) slowestEl.innerText = `${formatDurationText(slowest.avg)} (${cleanName(slowest.name)})`;
            } else {
                if (fastestEl) fastestEl.innerText = '--';
                if (slowestEl) slowestEl.innerText = '--';
            }

            const maxAvgAll = Math.max(...computedRobos.map(r => r.avg), 0.1);

            let html = '';
            computedRobos.forEach((robo, index) => {
                const rank = index + 1;
                const pctBar = Math.max(12, Math.min(100, Math.round((robo.avg / maxAvgAll) * 100)));

                let speedClass = 'speed-fast';
                if (robo.avg >= 2.0) {
                    speedClass = 'speed-slow';
                } else if (robo.avg >= 0.9) {
                    speedClass = 'speed-normal';
                }

                const rankClass = rank === 1 ? 'rank-1' : (rank === 2 ? 'rank-2' : (rank === 3 ? 'rank-3' : ''));

                html += `
                    <div class="robot-time-card">
                        <div class="robot-time-top">
                            <div class="robot-time-info">
                                <span class="robot-rank-num ${rankClass}">#${rank}</span>
                                <span class="robot-time-name" title="${robo.name}">
                                    <i class="fas fa-robot" style="color:var(--accent); font-size:0.8rem; margin-right:3px;"></i>${robo.name}
                                </span>
                                <span class="robot-time-exec-count">(${robo.count} exec.)</span>
                            </div>
                            <span class="robot-time-badge ${speedClass}">
                                <i class="fas fa-clock" style="font-size:0.7rem;"></i> ${formatDurationText(robo.avg)}
                            </span>
                        </div>
                        <div class="robot-time-track">
                            <div class="robot-time-fill ${speedClass}" style="width: ${pctBar}%;"></div>
                        </div>
                        <div class="robot-time-meta">
                            <span>Mín: <strong>${formatDurationText(robo.min)}</strong></span>
                            <span style="opacity:0.8;">Média por ciclo</span>
                            <span>Máx: <strong>${formatDurationText(robo.max)}</strong></span>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // ==========================================
        // 6. HISTÓRICO DE EXECUÇÕES (TAB 2)
        // ==========================================
        function renderHistoryTable(data) {
            const tbody = document.getElementById('history-full-tbody');
            const pageInfo = document.getElementById('history-page-info');
            const btnsContainer = document.getElementById('history-pagination-btns');

            const total = data.length;
            if (total === 0) {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding:30px; color:var(--text-muted);">Nenhum registro encontrado para os filtros selecionados.</td></tr>';
                pageInfo.innerText = 'Mostrando 0 de 0 registros';
                btnsContainer.innerHTML = '';
                return;
            }

            const totalPages = Math.ceil(total / historyPageSize);
            if (historyCurrentPage > totalPages) historyCurrentPage = totalPages;
            if (historyCurrentPage < 1) historyCurrentPage = 1;

            const startIndex = (historyCurrentPage - 1) * historyPageSize;
            const endIndex = Math.min(startIndex + historyPageSize, total);
            const pageData = data.slice(startIndex, endIndex);

            pageInfo.innerText = `Mostrando ${startIndex + 1} a ${endIndex} de ${total} registros`;

            let html = '';
            pageData.forEach(row => {
                const isErr = (row.StatusVerificacao || '').toLowerCase() === 'erro';
                const hasCorrection = row.CorrecaoErro && row.CorrecaoErro.trim().length > 0;

                let statusBadge = '<span class="robot-badge-pill badge-success"><i class="fas fa-check-circle"></i> SUCESSO</span>';
                if (hasCorrection) {
                    statusBadge = '<span class="robot-badge-pill badge-corrigido"><i class="fas fa-check-double"></i> CORRIGIDO</span>';
                } else if (isErr) {
                    statusBadge = '<span class="robot-badge-pill badge-error"><i class="fas fa-times-circle"></i> ERRO</span>';
                }

                const etapaOuErro = row.MensagemErro || row.Etapa || 'Fluxo finalizado com sucesso!';

                html += `
                    <tr class="${(isErr && !hasCorrection) ? 'row-danger' : ''}">
                        <td class="table-id-tag">#${row.IdLog}</td>
                        <td style="font-weight:600;">${row.Robo}</td>
                        <td style="font-size:0.8rem; white-space:nowrap;">${row.DataInicio || '--'}</td>
                        <td style="font-weight:600;">${row.DuracaoVerificacaoEmMinutos != null ? row.DuracaoVerificacaoEmMinutos + 'm' : '--'}</td>
                        <td>${statusBadge}</td>
                        <td style="max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${etapaOuErro}">
                            ${etapaOuErro}
                            ${hasCorrection ? `<div style="font-size:0.72rem; color:#15803d; font-weight:600; margin-top:2px;"><i class="fas fa-comment"></i> ${row.CorrecaoErro}</div>` : ''}
                        </td>
                        <td>
                            <button class="btn-screenshot-action" onclick="openModal(${row.IdLog})">
                                <i class="fas fa-camera"></i> Ver / Comentar
                            </button>
                        </td>
                        <td style="text-align:center;">
                            <button class="btn-more-actions" title="Mais opções" onclick="openModal(${row.IdLog})">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;

            // Renderizar botões de paginação: < [1] 2 3 ... 25 >
            let paginationHtml = `
                <button class="btn-page" ${historyCurrentPage === 1 ? 'disabled' : ''} onclick="changeHistoryPage(${historyCurrentPage - 1})">
                    <i class="fas fa-chevron-left"></i>
                </button>
            `;

            const maxVisiblePages = 5;
            let startP = Math.max(1, historyCurrentPage - 2);
            let endP = Math.min(totalPages, startP + maxVisiblePages - 1);
            if (endP - startP < maxVisiblePages - 1) {
                startP = Math.max(1, endP - maxVisiblePages + 1);
            }

            if (startP > 1) {
                paginationHtml += `<button class="btn-page" onclick="changeHistoryPage(1)">1</button>`;
                if (startP > 2) paginationHtml += `<span style="padding:0 4px; color:var(--text-muted);">...</span>`;
            }

            for (let p = startP; p <= endP; p++) {
                paginationHtml += `
                    <button class="btn-page ${p === historyCurrentPage ? 'active' : ''}" onclick="changeHistoryPage(${p})">
                        ${p}
                    </button>
                `;
            }

            if (endP < totalPages) {
                if (endP < totalPages - 1) paginationHtml += `<span style="padding:0 4px; color:var(--text-muted);">...</span>`;
                paginationHtml += `<button class="btn-page" onclick="changeHistoryPage(${totalPages})">${totalPages}</button>`;
            }

            paginationHtml += `
                <button class="btn-page" ${historyCurrentPage === totalPages ? 'disabled' : ''} onclick="changeHistoryPage(${historyCurrentPage + 1})">
                    <i class="fas fa-chevron-right"></i>
                </button>
            `;

            btnsContainer.innerHTML = paginationHtml;
        }

        function changeHistoryPage(page) {
            historyCurrentPage = page;
            renderHistoryTable(getFilteredData());
        }

