<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Robôs - Monitoramento e Execução de Processos</title>
    
    <!-- Google Fonts & FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom CSS Light Theme Dashboard CPD -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/monitor_robos.css') }}?v=2.0">
</head>
<body>
    <div class="app-wrapper">
        <!-- TOP NAVBAR -->
        <header class="top-navbar">
            <div class="brand-section">
                <div class="brand-icon-box">
                    <i class="fas fa-robot"></i>
                </div>
                <div class="brand-info">
                    <h1>Robôs</h1>
                    <span>Monitoramento e execução de processos</span>
                </div>
            </div>

            <!-- FILTERS IN HEADER -->
            <div class="filters-container">
                <div class="filter-item">
                    <span class="filter-label">Robô:</span>
                    <select class="filter-select" id="filter-robo">
                        <option value="ALL">Todos</option>
                    </select>
                </div>

                <div class="filter-item">
                    <span class="filter-label">Período:</span>
                    <select class="filter-select" id="filter-periodo">
                        <option value="24h">Últimas 24h</option>
                        <option value="today">Hoje</option>
                        <option value="7d">Últimos 7 dias</option>
                        <option value="ALL">Todos</option>
                    </select>
                </div>

                <div class="filter-search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="filter-search" placeholder="Pesquisar robô ou erro...">
                </div>

                <div class="status-pills">
                    <button class="btn-pill active" data-status="ALL">Todos</button>
                    <button class="btn-pill pill-success" data-status="SUCESSO"><i class="fas fa-circle" style="font-size:0.5rem; color:#10b981;"></i> Sucesso</button>
                    <button class="btn-pill pill-error" data-status="ERRO"><i class="fas fa-circle" style="font-size:0.5rem; color:#ef4444;"></i> Erros</button>
                    <button class="btn-pill pill-warning" data-status="ALERTA"><i class="fas fa-exclamation-triangle" style="font-size:0.65rem; color:#f59e0b;"></i> Alertas</button>
                </div>
            </div>

            <!-- TOPBAR RIGHT CONTROLS -->
            <div class="topbar-right">
                <div class="update-badge">
                    <span>Última atualização</span>
                    <strong id="last-update">--:--:--</strong>
                </div>
                <button class="btn-refresh" id="btn-refresh" title="Atualizar agora" onclick="handleManualRefresh()">
                    <i class="fas fa-sync-alt"></i>
                </button>
                <a href="/" class="btn-back-dash" title="Voltar ao Dashboard CPD">
                    <i class="fas fa-arrow-left"></i> Dashboard
                </a>
            </div>
        </header>

        <!-- MAIN LAYOUT: SIDEBAR + CONTENT -->
        <div class="layout-container">
            <!-- SIDEBAR NAVIGATION -->
            <aside class="sidebar-nav">
                <button class="nav-tab-btn active" data-tab="tab-dashboard">
                    <i class="fas fa-th-large"></i> Dashboard
                </button>
                <button class="nav-tab-btn" data-tab="tab-historico">
                    <i class="fas fa-history"></i> Histórico
                </button>
                <button class="nav-tab-btn" data-tab="tab-relatorios">
                    <i class="fas fa-chart-bar"></i> Relatórios
                </button>
                <button class="nav-tab-btn" data-tab="tab-configuracoes">
                    <i class="fas fa-cog"></i> Configurações
                </button>
            </aside>

            <!-- CONTENT AREA -->
            <main class="content-area">
                <!-- ========================================== -->
                <!-- TAB 1: DASHBOARD                           -->
                <!-- ========================================== -->
                <div class="tab-pane active" id="tab-dashboard">
                    <!-- TOP 5 KPI CARDS -->
                    <div class="kpi-row">
                        <!-- 1. Robôs Ativos -->
                        <div class="kpi-card">
                            <div class="kpi-header">
                                <span class="kpi-title">Robôs Ativos</span>
                                <div class="kpi-icon-wrap icon-blue"><i class="fas fa-microchip"></i></div>
                            </div>
                            <div class="kpi-body">
                                <div>
                                    <div class="kpi-val"><span id="kpi-robos-ativos">0</span> <span style="font-size:1.1rem; color:var(--text-muted); font-weight:500;">de</span> <span id="kpi-robos-total">0</span></div>
                                    <div class="kpi-subtext" id="kpi-robos-sub" style="margin-top:4px;">0% em execução</div>
                                </div>
                            </div>
                            <div class="kpi-progress-bar">
                                <div class="kpi-progress-fill" id="kpi-robos-bar" style="width: 0%"></div>
                            </div>
                        </div>

                        <!-- 2. Execuções -->
                        <div class="kpi-card">
                            <div class="kpi-header">
                                <span class="kpi-title">Execuções</span>
                                <div class="kpi-icon-wrap icon-purple"><i class="fas fa-play"></i></div>
                            </div>
                            <div class="kpi-body">
                                <div class="kpi-val" id="kpi-execucoes">0</div>
                                <span class="kpi-trend-pill" id="kpi-exec-trend">▲ 12% vs. ant.</span>
                            </div>
                            <div class="kpi-sparkline-container">
                                <canvas id="spark-execs"></canvas>
                            </div>
                        </div>

                        <!-- 3. Sucessos -->
                        <div class="kpi-card">
                            <div class="kpi-header">
                                <span class="kpi-title">Sucessos</span>
                                <div class="kpi-icon-wrap icon-green"><i class="fas fa-check-circle"></i></div>
                            </div>
                            <div class="kpi-body">
                                <div class="kpi-val" id="kpi-sucessos" style="color:#059669;">0</div>
                                <div class="kpi-subtext" id="kpi-sucesso-taxa" style="font-weight:700; color:#059669;">0%</div>
                            </div>
                            <div class="kpi-sparkline-container">
                                <canvas id="spark-sucesso"></canvas>
                            </div>
                        </div>

                        <!-- 4. Erros / Pendentes -->
                        <div class="kpi-card" style="border-left: 4px solid var(--error);">
                            <div class="kpi-header">
                                <span class="kpi-title">Erros / Pendentes</span>
                                <div class="kpi-icon-wrap icon-red"><i class="fas fa-times-circle"></i></div>
                            </div>
                            <div class="kpi-body">
                                <div>
                                    <span class="kpi-val" id="kpi-erros-total" style="color:var(--error);">0</span>
                                    <span style="font-size:0.82rem; color:var(--text-muted); font-weight:600; margin-left:4px;">pendentes</span>
                                    <span class="kpi-val" id="kpi-erros-pendentes" style="color:#d97706; font-size:1.4rem; margin-left:4px;">0</span>
                                </div>
                            </div>
                            <div class="kpi-subtext" id="kpi-erros-sub" style="margin-top:auto;">0 corrigidos | 0 pendentes</div>
                        </div>

                        <!-- 5. Taxa de Sucesso -->
                        <div class="kpi-card">
                            <div class="kpi-header">
                                <span class="kpi-title">Taxa de Sucesso</span>
                                <div class="kpi-icon-wrap icon-blue"><i class="fas fa-percentage"></i></div>
                            </div>
                            <div class="kpi-body">
                                <div class="kpi-val" id="kpi-taxa-geral">0%</div>
                                <span class="kpi-trend-pill" id="kpi-taxa-trend">▲ 2% vs. ant.</span>
                            </div>
                            <div class="kpi-sparkline-container">
                                <canvas id="spark-taxa"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- MIDDLE ROW: 3 PANELS -->
                    <div class="middle-row">
                        <!-- Panel 1: Execuções por Tipo -->
                        <div class="panel-card">
                            <div class="panel-header">
                                <div class="panel-title">
                                    <i class="fas fa-chart-pie"></i> Execuções por Tipo (<span id="panel-type-period">Últimas 24h</span>)
                                </div>
                            </div>
                            <div class="donut-container">
                                <canvas id="donutTypeChart"></canvas>
                                <div class="donut-center-text">
                                    <div class="donut-center-val" id="donut-total-val">0</div>
                                    <div class="donut-center-sub">execuções</div>
                                </div>
                            </div>
                            <div class="category-legend" id="donut-legend">
                                <!-- Preenchido dinamicamente -->
                            </div>
                        </div>

                        <!-- Panel 2: Tempo Médio de Execução -->
                        <div class="panel-card">
                            <div class="panel-header">
                                <div class="panel-title">
                                    <i class="fas fa-chart-line"></i> Tempo Médio de Execução
                                </div>
                            </div>
                            <div class="time-stats-header">
                                <div class="time-stat-badge">Média geral: <strong id="time-stat-avg">--</strong></div>
                                <div class="time-stat-badge">Mais rápido: <strong id="time-stat-fastest">--</strong></div>
                                <div class="time-stat-badge">Mais lento: <strong id="time-stat-slowest">--</strong></div>
                            </div>
                            <div class="line-chart-container">
                                <canvas id="timeLineChart"></canvas>
                            </div>
                        </div>

                        <!-- Panel 3: Status dos Robôs -->
                        <div class="panel-card">
                            <div class="panel-header">
                                <div class="panel-title">
                                    <i class="fas fa-robot"></i> Status dos Robôs (<span id="panel-robots-period">Últimas 24h</span>)
                                </div>
                            </div>
                            <div class="robots-status-list" id="robots-status-list">
                                <div style="text-align:center; padding:30px; color:var(--text-muted);">
                                    <i class="fas fa-spinner fa-spin"></i> Carregando robôs...
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BOTTOM ROW: 2 PANELS -->
                    <div class="bottom-row">
                        <!-- Panel 1: Últimos Erros -->
                        <div class="panel-card">
                            <div class="panel-header">
                                <div class="panel-title">
                                    <i class="fas fa-bug" style="color:var(--error);"></i> Últimos Erros
                                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <span style="font-size:0.75rem; color:var(--text-muted);" id="errors-count-badge">0 encontrados</span>
                                    <button id="btn-corrigir-todos" class="btn-corrigir-todos" onclick="abrirModalCorrigirTodos()" title="Corrigir todos os erros encontrados de uma vez">
                                        <i class="fas fa-check-double"></i> Corrigir Todos
                                    </button>
                                </div>
                            </div>
                            <div style="overflow-x:auto; flex:1;" id="errors-table-wrap">
                                <table class="errors-mini-table" id="errors-mini-table">
                                    <thead>
                                        <tr>
                                            <th>ID Log</th>
                                            <th>Robô</th>
                                            <th>Mensagem</th>
                                            <th>Data / Hora</th>
                                            <th style="text-align:right;">Ação</th>
                                        </tr>
                                    </thead>
                                    <tbody id="latest-errors-tbody">
                                        <!-- Dynamic rows -->
                                    </tbody>
                                </table>
                                <div class="empty-state" id="errors-empty-state" style="display:none;">
                                    <div class="empty-state-icon">
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <p>Nenhum erro registrado neste período.</p>
                                    <span style="font-size:0.75rem; color:var(--text-muted); margin-top:4px;">Todos os fluxos foram executados com êxito!</span>
                                </div>
                            </div>
                        </div>

                        <!-- Panel 2: Tempo Médio de Execução por Robô -->
                        <div class="panel-card" id="card-tempo-medio-robos">
                            <div class="panel-header">
                                <div class="panel-title">
                                    <i class="fas fa-stopwatch" style="color:var(--accent);"></i> Tempo Médio por Robô
                                </div>
                                <span style="font-size:0.75rem; color:var(--text-muted);" id="robots-avg-time-count">0 robôs</span>
                            </div>
                            <div class="time-stats-header" style="justify-content: space-between; margin-bottom: 8px;">
                                <div class="time-stat-badge">⚡ Mais rápido: <strong id="robot-avg-fastest">--</strong></div>
                                <div class="time-stat-badge">🐢 Mais lento: <strong id="robot-avg-slowest">--</strong></div>
                            </div>
                            <div class="robots-avg-list-container" id="robots-avg-time-list">
                                <div style="text-align:center; padding:30px; color:var(--text-muted);">
                                    <i class="fas fa-spinner fa-spin"></i> Carregando tempos médios...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- TAB 2: HISTÓRICO                           -->
                <!-- ========================================== -->
                <div class="tab-pane" id="tab-historico">
                    <div class="history-card">
                        <div class="history-header">
                            <div class="panel-title" style="font-size:1.15rem;">
                                <i class="fas fa-history" style="color:var(--accent);"></i> Histórico de Execuções
                            </div>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span style="font-size:0.8rem; color:var(--text-muted);">Exibir:</span>
                                <select id="history-page-size" class="filter-select" style="border:1px solid var(--card-border); padding:4px 8px; border-radius:6px; background:#fff;">
                                    <option value="10" selected>10 registros</option>
                                    <option value="25">25 registros</option>
                                    <option value="50">50 registros</option>
                                    <option value="100">100 registros</option>
                                </select>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>ID Log</th>
                                        <th>Robô</th>
                                        <th>Início</th>
                                        <th>Duração</th>
                                        <th>Status</th>
                                        <th>Etapa / Erro</th>
                                        <th>Screenshot</th>
                                        <th style="text-align:center;">Ações</th>
                                    </tr>
                                </thead>
                                <tbody id="history-full-tbody">
                                    <!-- Dynamic Rows -->
                                </tbody>
                            </table>
                        </div>

                        <!-- PAGINATION -->
                        <div class="pagination-bar">
                            <div id="history-page-info">Mostrando 0 de 0 registros</div>
                            <div class="pagination-controls" id="history-pagination-btns">
                                <!-- Dynamic buttons -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- TAB 3: RELATÓRIOS                          -->
                <!-- ========================================== -->
                <div class="tab-pane" id="tab-relatorios">
                    <div class="history-card">
                        <div class="history-header">
                            <div class="panel-title" style="font-size:1.15rem;">
                                <i class="fas fa-chart-bar" style="color:var(--primary);"></i> Relatórios Analíticos de Execução
                            </div>
                            <button class="btn-pill" onclick="exportDataCSV()">
                                <i class="fas fa-file-csv"></i> Exportar CSV
                            </button>
                        </div>
                        <p style="color:var(--text-muted); font-size:0.85rem; margin-top:0;">Resumo consolidado do desempenho e estabilidade de cada robô monitorado.</p>
                        
                        <div class="table-responsive" style="margin-top:14px;">
                            <table class="data-table" id="report-summary-table">
                                <thead>
                                    <tr>
                                        <th>Nome do Robô</th>
                                        <th>Total Execuções</th>
                                        <th>Sucessos</th>
                                        <th>Erros</th>
                                        <th>Corrigidos</th>
                                        <th>Taxa Sucesso</th>
                                        <th>Duração Média</th>
                                        <th>Última Execução</th>
                                    </tr>
                                </thead>
                                <tbody id="report-tbody">
                                    <!-- Dynamic Rows -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- TAB 4: CONFIGURAÇÕES                       -->
                <!-- ========================================== -->
                <div class="tab-pane" id="tab-configuracoes">
                    <div class="history-card" style="max-width:800px;">
                        <div class="history-header">
                            <div class="panel-title" style="font-size:1.15rem;">
                                <i class="fas fa-cog" style="color:var(--primary);"></i> Configurações do Monitoramento E2E
                            </div>
                        </div>
                        
                        <div style="display:flex; flex-direction:column; gap:20px; margin-top:10px;">
                            <div class="info-card-box">
                                <div style="font-weight:700; color:var(--text-primary); margin-bottom:4px;">Atualização Automática (Intervalo)</div>
                                <div style="font-size:0.8rem; color:var(--text-muted); margin-bottom:10px;">Frequência com que o painel requisita novos registros da base de dados.</div>
                                <select id="setting-refresh-interval" class="filter-select" style="border:1px solid var(--card-border); padding:6px 12px; border-radius:6px; background:#fff;">
                                    <option value="5000">A cada 5 segundos</option>
                                    <option value="10000" selected>A cada 10 segundos (Padrão)</option>
                                    <option value="30000">A cada 30 segundos</option>
                                    <option value="60000">A cada 1 minuto</option>
                                    <option value="0">Desativado (Manual)</option>
                                </select>
                            </div>

                            <div class="info-card-box">
                                <div style="font-weight:700; color:var(--text-primary); margin-bottom:4px;">Threshold de Alerta (Robô Inativo)</div>
                                <div style="font-size:0.8rem; color:var(--text-muted); margin-bottom:10px;">Considerar robô em estado de alerta caso não execute há mais de:</div>
                                <select id="setting-alert-hours" class="filter-select" style="border:1px solid var(--card-border); padding:6px 12px; border-radius:6px; background:#fff;">
                                    <option value="2">2 horas</option>
                                    <option value="4" selected>4 horas (Padrão)</option>
                                    <option value="8">8 horas</option>
                                    <option value="24">24 horas</option>
                                </select>
                            </div>

                            <div class="info-card-box">
                                <div style="font-weight:700; color:var(--text-primary); margin-bottom:4px;">Informações do Servidor</div>
                                <div style="font-size:0.8rem; color:var(--text-muted);">
                                    Ambiente: <strong>Produção CPD</strong><br>
                                    Origem dos dados: <strong>robosmonitoramentotelaslog (SQL Server)</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- MODAL DE DETALHES & SCREENSHOT (LIGHT CPD) -->
    <!-- ========================================== -->
    <div class="modal-overlay" id="detail-modal">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-title-group">
                    <div class="kpi-icon-wrap icon-blue" style="width:36px; height:36px; font-size:1.1rem;">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div>
                        <div class="modal-title" id="mdl-title">Robô</div>
                        <span id="mdl-id" style="font-size:0.8rem; color:var(--text-muted); font-weight:600;">#0000</span>
                    </div>
                </div>
                <button class="modal-close-btn" onclick="closeModal()"><i class="fas fa-times"></i></button>
            </div>
            
            <div class="modal-body">
                <!-- Coluna Esquerda: Informações & Ações -->
                <div class="modal-left-details">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span id="mdl-status" class="robot-badge-pill badge-success">SUCESSO</span>
                    </div>

                    <div class="info-card-box">
                        <div class="info-card-title">Metadados de Execução</div>
                        <div class="info-grid">
                            <div class="info-grid-item">
                                <span>Início:</span>
                                <strong id="mdl-inicio">--</strong>
                            </div>
                            <div class="info-grid-item">
                                <span>Fim:</span>
                                <strong id="mdl-fim">--</strong>
                            </div>
                            <div class="info-grid-item">
                                <span>Duração:</span>
                                <strong id="mdl-duracao">--</strong>
                            </div>
                            <div class="info-grid-item">
                                <span>Etapa:</span>
                                <strong id="mdl-etapa">--</strong>
                            </div>
                        </div>
                    </div>

                    <div class="error-callout" id="mdl-error-block" style="display:none;">
                        <div style="font-weight:700; margin-bottom:4px;"><i class="fas fa-exclamation-circle"></i> Mensagem de Erro Registrada:</div>
                        <div id="mdl-erro">--</div>
                    </div>

                    <div class="comment-box">
                        <div class="comment-header">
                            <span><i class="fas fa-comment-dots"></i> Resolução / Comentário da Equipe CPD</span>
                            <span id="mdl-correcao-data" style="font-size:0.72rem; color:var(--text-muted); font-weight:normal;"></span>
                        </div>
                        <textarea id="mdl-correcao-input" class="comment-textarea" placeholder="Descreva a ação tomada para corrigir este erro (ex: Reiniciado serviço, ajustado seletor, liberado IP, etc)..."></textarea>
                        <div>
                            <button id="btn-salvar-correcao" class="btn-save-comment" onclick="salvarCorrecaoLog()">
                                <i class="fas fa-save"></i> Salvar Comentário
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Coluna Direita: Screenshot -->
                <div class="modal-right-screenshot">
                    <div class="screenshot-toolbar">
                        <span><i class="fas fa-camera"></i> Evidência de Execução (Screenshot)</span>
                        <a id="mdl-screenshot-download" href="#" target="_blank" style="color:#60a5fa; text-decoration:none; font-weight:600; display:none;">
                            <i class="fas fa-external-link-alt"></i> Abrir Original
                        </a>
                    </div>
                    <div class="screenshot-viewport">
                        <div class="screenshot-loader" id="mdl-img-loader">
                            <i class="fas fa-circle-notch fa-spin fa-2x"></i><br><br>Carregando evidência...
                        </div>
                        <img id="mdl-img" src="" alt="Screenshot da Execução" style="display:none;" />
                        <div class="screenshot-empty" id="mdl-img-empty" style="display:none;">
                            <i class="fas fa-image fa-3x" style="opacity:0.3; margin-bottom:10px; display:block;"></i>
                            Sem screenshot capturado para esta execução
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- MODAL DE CORREÇÃO EM LOTE (CORRIGIR TODOS)  -->
    <!-- ========================================== -->
    <div class="modal-overlay" id="modal-corrigir-todos" style="display:none;">
        <div class="modal-card" style="max-width:540px; min-width:320px; max-height:90vh; overflow-y:auto;">
            <div class="modal-header">
                <div class="modal-title-group">
                    <div class="kpi-icon-wrap" style="width:38px; height:38px; font-size:1.1rem; background:rgba(16, 185, 129, 0.12); color:#059669; border-radius:10px;">
                        <i class="fas fa-check-double"></i>
                    </div>
                    <div>
                        <div class="modal-title" style="font-size:1.05rem;">Corrigir Erros em Lote</div>
                        <span style="font-size:0.78rem; color:var(--text-muted); font-weight:600;">Regularização de falhas registradas</span>
                    </div>
                </div>
                <button class="modal-close-btn" onclick="fecharModalCorrigirTodos()"><i class="fas fa-times"></i></button>
            </div>
            
            <div class="modal-body" style="padding:18px 22px; display:flex; flex-direction:column; gap:16px;">
                <!-- Card de Resumo de Erros -->
                <div style="background:#f8fafc; border:1px solid var(--card-border); border-radius:10px; padding:14px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                        <span style="font-size:0.85rem; font-weight:700; color:var(--text-primary);">
                            <i class="fas fa-list-check" style="color:var(--primary); margin-right:6px;"></i> Erros que serão corrigidos:
                        </span>
                        <span class="robot-badge-pill badge-error" id="corrigir-todos-count-badge">0 erros</span>
                    </div>
                    <div id="corrigir-todos-resumo-robos" style="font-size:0.8rem; color:var(--text-secondary); line-height:1.6; max-height:140px; overflow-y:auto; padding-right:4px;">
                        <!-- Robôs e contagem gerados dinamicamente -->
                    </div>
                </div>

                <!-- Campo de Comentário / Justificativa -->
                <div class="comment-box" style="margin-top:0;">
                    <label style="display:block; font-size:0.82rem; font-weight:700; color:var(--text-primary); margin-bottom:6px;">
                        <i class="fas fa-comment-dots" style="color:var(--accent);"></i> Justificativa / Comentário da Resolução:
                    </label>
                    <textarea id="corrigir-todos-input" class="comment-textarea" style="min-height:80px; font-size:0.82rem;" placeholder="Ex: Problema pontual resolvido / Seletores reajustados / Erros analisados e regularizados pelo CPD..."></textarea>
                    <div style="font-size:0.74rem; color:var(--text-muted); margin-top:4px;">
                        * Este comentário e a data atual serão gravados com status <strong>CORRIGIDO</strong> em todos os logs selecionados.
                    </div>
                </div>

                <!-- Ações do Modal -->
                <div style="display:flex; justify-content:flex-end; align-items:center; gap:10px; padding-top:6px; border-top:1px solid #f1f5f9;">
                    <button type="button" class="btn-cancel-modal" onclick="fecharModalCorrigirTodos()">
                        Cancelar
                    </button>
                    <button type="button" id="btn-confirmar-corrigir-todos" class="btn-confirm-modal" onclick="executarCorrigirTodos()">
                        <i class="fas fa-check-circle"></i> Confirmar e Resolver Todos
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- CONTROLLER JAVASCRIPT LOGIC                -->
    <!-- ========================================== -->
    <script>
        let allData = [];
        let currentFilterStatus = 'ALL';
        let refreshIntervalTimer = null;
        let refreshIntervalMs = 10000;
        let alertInactiveHours = 4;
        
        // Paginação do Histórico
        let historyCurrentPage = 1;
        let historyPageSize = 10;
        let currentModalLogId = null;

        // Instâncias de Gráficos Chart.js
        let donutTypeChart = null;
        let timeLineChart = null;
        let sparkExecsChart = null;
        let sparkSucessoChart = null;
        let sparkTaxaChart = null;

        // Regras de Classificação de Erros
        const ERROR_CATEGORIES = {
            'Timeout': /timeout|waiting for selector|navigation timeout|timed out/i,
            'Página / Seletor': /element not found|selector not found|não encontrado|xpath|css selector|is not clickable|stale element/i,
            'Autenticação': /login|unauthorized|session expired|access denied|senha incorreta|credenciais/i,
            'Regra': /regra|validação|fora do prazo|não permitido|inconsistência|aluno cancelado/i,
            'Robô / Script': /python exception|driver|chrome|playwright|selenium|indexerror|keyerror|nullreference/i,
            'Outros': /.*/
        };

        const CATEGORY_COLORS = {
            'Timeout': '#f59e0b',
            'Página / Seletor': '#ef4444',
            'Autenticação': '#3b82f6',
            'Regra': '#8b5cf6',
            'Robô / Script': '#ec4899',
            'Outros': '#64748b'
        };

        // ==========================================
        // INICIALIZAÇÃO
        // ==========================================
        document.addEventListener('DOMContentLoaded', () => {
            initSparklines();
            initCharts();
            setupEventListeners();
            fetchData();
            startAutoRefresh();
        });

        function setupEventListeners() {
            // Tab Switching
            document.querySelectorAll('.nav-tab-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const targetBtn = e.currentTarget;
                    const targetTab = targetBtn.dataset.tab;

                    document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));
                    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));

                    targetBtn.classList.add('active');
                    const targetPane = document.getElementById(targetTab);
                    if (targetPane) targetPane.classList.add('active');

                    // Se alternou para histórico ou relatórios, re-renderizar
                    if (targetTab === 'tab-historico') {
                        renderHistoryTable(getFilteredData());
                    } else if (targetTab === 'tab-relatorios') {
                        renderReports(getFilteredData());
                    } else if (targetTab === 'tab-dashboard') {
                        // Forçar redimensionamento dos charts para garantir layout perfeito
                        if (donutTypeChart) donutTypeChart.resize();
                        if (timeLineChart) timeLineChart.resize();
                    }
                });
            });

            // Status Pills
            document.querySelectorAll('.btn-pill[data-status]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    document.querySelectorAll('.btn-pill[data-status]').forEach(b => b.classList.remove('active'));
                    e.currentTarget.classList.add('active');
                    currentFilterStatus = e.currentTarget.dataset.status;
                    historyCurrentPage = 1;
                    renderAll();
                });
            });

            // Filtros de busca, robô e período
            document.getElementById('filter-search').addEventListener('input', () => {
                historyCurrentPage = 1;
                renderAll();
            });

            document.getElementById('filter-robo').addEventListener('change', () => {
                historyCurrentPage = 1;
                renderAll();
            });

            document.getElementById('filter-periodo').addEventListener('change', (e) => {
                historyCurrentPage = 1;
                const txt = e.target.options[e.target.selectedIndex].text;
                document.getElementById('panel-type-period').innerText = txt;
                document.getElementById('panel-robots-period').innerText = txt;
                renderAll();
            });

            // Paginação tamanho
            document.getElementById('history-page-size').addEventListener('change', (e) => {
                historyPageSize = parseInt(e.target.value, 10);
                historyCurrentPage = 1;
                renderHistoryTable(getFilteredData());
            });

            // Configurações
            document.getElementById('setting-refresh-interval').addEventListener('change', (e) => {
                refreshIntervalMs = parseInt(e.target.value, 10);
                startAutoRefresh();
            });

            document.getElementById('setting-alert-hours').addEventListener('change', (e) => {
                alertInactiveHours = parseInt(e.target.value, 10);
                renderAll();
            });

            // Modal fechar ao clicar no fundo
            document.getElementById('detail-modal').addEventListener('click', (e) => {
                if (e.target.id === 'detail-modal') closeModal();
            });

            const modalCorrigirTodos = document.getElementById('modal-corrigir-todos');
            if (modalCorrigirTodos) {
                modalCorrigirTodos.addEventListener('click', (e) => {
                    if (e.target.id === 'modal-corrigir-todos') fecharModalCorrigirTodos();
                });
            }
        }

        // ==========================================
        // AUTO REFRESH & FETCH
        // ==========================================
        function startAutoRefresh() {
            if (refreshIntervalTimer) clearInterval(refreshIntervalTimer);
            if (refreshIntervalMs > 0) {
                refreshIntervalTimer = setInterval(fetchData, refreshIntervalMs);
            }
        }

        async function handleManualRefresh() {
            const btn = document.getElementById('btn-refresh');
            btn.classList.add('spinning');
            await fetchData();
            setTimeout(() => btn.classList.remove('spinning'), 600);
        }

        async function fetchData() {
            try {
                const res = await fetch('/api/monitor_robos');
                const json = await res.json();
                if (json.status === 'success') {
                    allData = json.data || [];
                    document.getElementById('last-update').innerText = new Date().toLocaleTimeString();
                    populateRoboFilter();
                    renderAll();
                } else {
                    console.error("Erro na API:", json.message);
                }
            } catch (err) {
                console.error("Falha ao buscar dados do monitor de robôs:", err);
            }
        }

        function populateRoboFilter() {
            const select = document.getElementById('filter-robo');
            const currentVal = select.value;
            const robos = [...new Set(allData.map(d => d.Robo).filter(Boolean))].sort();

            select.innerHTML = '<option value="ALL">Todos</option>';
            robos.forEach(r => {
                const opt = document.createElement('option');
                opt.value = r;
                opt.textContent = r;
                select.appendChild(opt);
            });

            if (robos.includes(currentVal)) {
                select.value = currentVal;
            }
        }

        // ==========================================
        // FILTRAGEM DE DADOS
        // ==========================================
        function getFilteredData() {
            const searchTerm = (document.getElementById('filter-search').value || '').toLowerCase().trim();
            const roboFilter = document.getElementById('filter-robo').value;
            const periodoFilter = document.getElementById('filter-periodo').value;

            const now = new Date();
            let cutoffDate = new Date(0);

            if (periodoFilter === '24h') {
                cutoffDate = new Date(now.getTime() - (24 * 60 * 60 * 1000));
            } else if (periodoFilter === 'today') {
                cutoffDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            } else if (periodoFilter === '7d') {
                cutoffDate = new Date(now.getTime() - (7 * 24 * 60 * 60 * 1000));
            }

            return allData.filter(d => {
                const dDate = new Date(d.DataFim || d.DataInicio);
                if (periodoFilter !== 'ALL' && dDate < cutoffDate) return false;

                // Status Filter
                const statusStr = (d.StatusVerificacao || '').toUpperCase();
                if (currentFilterStatus !== 'ALL') {
                    if (currentFilterStatus === 'SUCESSO' && statusStr !== 'SUCESSO') return false;
                    if (currentFilterStatus === 'ERRO' && statusStr !== 'ERRO') return false;
                    if (currentFilterStatus === 'ALERTA') {
                        // Verifica se robô está parado há mais do que alertInactiveHours
                        const diffHours = (now - dDate) / (1000 * 60 * 60);
                        if (diffHours <= alertInactiveHours) return false;
                    }
                }

                if (roboFilter !== 'ALL' && d.Robo !== roboFilter) return false;

                if (searchTerm) {
                    const text = `${d.IdLog} ${d.Robo} ${d.MensagemErro || ''} ${d.StatusVerificacao || ''} ${d.Etapa || ''} ${d.CorrecaoErro || ''}`.toLowerCase();
                    if (!text.includes(searchTerm)) return false;
                }

                return true;
            });
        }

        // ==========================================
        // RENDER GERAL
        // ==========================================
        function renderAll() {
            const data = getFilteredData();

            updateKPIs(data);
            updateDonutChart(data);
            updateTimeLineChart(data);
            renderRobotsStatusList(data);
            renderLatestErrors(data);
            renderRobotsAvgTime(data);
            renderHistoryTable(data);
            renderReports(data);
        }

        // ==========================================
        // 1. TOP 5 KPIS & SPARKLINES
        // ==========================================
        function updateKPIs(data) {
            // Total de robôs no sistema vs robôs ativos no período
            const allConfiguredRobos = [...new Set(allData.map(d => d.Robo).filter(Boolean))];
            const activeRobos = [...new Set(data.map(d => d.Robo).filter(Boolean))];
            
            const totalRobosCount = allConfiguredRobos.length || 1;
            const activeRobosCount = activeRobos.length;
            const activePct = Math.round((activeRobosCount / totalRobosCount) * 100);

            document.getElementById('kpi-robos-ativos').innerText = activeRobosCount;
            document.getElementById('kpi-robos-total').innerText = totalRobosCount;
            document.getElementById('kpi-robos-sub').innerText = `${activePct}% em execução`;
            document.getElementById('kpi-robos-bar').style.width = `${activePct}%`;

            // Execuções
            const totalExecs = data.length;
            document.getElementById('kpi-execucoes').innerText = totalExecs;

            // Sucessos
            const sucessos = data.filter(d => (d.StatusVerificacao || '').toLowerCase() === 'sucesso').length;
            document.getElementById('kpi-sucessos').innerText = sucessos;
            const taxaSucesso = totalExecs > 0 ? ((sucessos / totalExecs) * 100).toFixed(1) : '0.0';
            document.getElementById('kpi-sucesso-taxa').innerText = `${taxaSucesso}%`;

            // Erros & Pendentes
            const errosList = data.filter(d => (d.StatusVerificacao || '').toLowerCase() === 'erro');
            const totalErros = errosList.length;
            const pendentes = errosList.filter(d => !d.CorrecaoErro || !d.CorrecaoErro.trim()).length;
            const corrigidos = totalErros - pendentes;

            document.getElementById('kpi-erros-total').innerText = totalErros;
            document.getElementById('kpi-erros-pendentes').innerText = pendentes;
            document.getElementById('kpi-erros-sub').innerText = `${corrigidos} corrigidos | ${pendentes} pendentes de correção`;

            // Taxa Geral
            const taxaInt = totalExecs > 0 ? Math.round((sucessos / totalExecs) * 100) : 0;
            document.getElementById('kpi-taxa-geral').innerText = `${taxaInt}%`;

            // Atualizar Sparklines com dados simulados/reais por bloco de horas
            updateSparklinesData(data);
        }

        function initSparklines() {
            const commonSparkOptions = {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                resizeDelay: 100,
                plugins: { legend: { display: false }, tooltip: { enabled: false } },
                scales: { x: { display: false }, y: { display: false } },
                elements: { point: { radius: 0 } }
            };

            // Spark Execuções
            const ctx1 = document.getElementById('spark-execs').getContext('2d');
            sparkExecsChart = new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: [1, 2, 3, 4, 5, 6, 7, 8],
                    datasets: [{
                        data: [4, 6, 8, 5, 9, 7, 10, 8],
                        borderColor: '#8b5cf6',
                        backgroundColor: 'rgba(139, 92, 246, 0.08)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: commonSparkOptions
            });

            // Spark Sucessos
            const ctx2 = document.getElementById('spark-sucesso').getContext('2d');
            sparkSucessoChart = new Chart(ctx2, {
                type: 'line',
                data: {
                    labels: [1, 2, 3, 4, 5, 6, 7, 8],
                    datasets: [{
                        data: [4, 5, 7, 5, 8, 7, 9, 8],
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.08)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: commonSparkOptions
            });

            // Spark Taxa
            const ctx3 = document.getElementById('spark-taxa').getContext('2d');
            sparkTaxaChart = new Chart(ctx3, {
                type: 'line',
                data: {
                    labels: [1, 2, 3, 4, 5, 6, 7, 8],
                    datasets: [{
                        data: [95, 96, 94, 98, 97, 98, 99, 98],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.08)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: commonSparkOptions
            });
        }

        function updateSparklinesData(data) {
            if (!sparkExecsChart || !sparkSucessoChart || !sparkTaxaChart) return;
            // Gera 8 buckets de tempo baseados no dataset
            const buckets = Array(8).fill(0);
            const succBuckets = Array(8).fill(0);

            data.slice(-80).forEach((d, idx) => {
                const bIdx = idx % 8;
                buckets[bIdx]++;
                if ((d.StatusVerificacao || '').toLowerCase() === 'sucesso') succBuckets[bIdx]++;
            });

            sparkExecsChart.data.datasets[0].data = buckets;
            sparkExecsChart.update('none');

            sparkSucessoChart.data.datasets[0].data = succBuckets;
            sparkSucessoChart.update('none');

            const taxaBuckets = buckets.map((tot, i) => tot > 0 ? Math.round((succBuckets[i] / tot) * 100) : 100);
            sparkTaxaChart.data.datasets[0].data = taxaBuckets;
            sparkTaxaChart.update('none');
        }

        // ==========================================
        // 2. DONUT: EXECUÇÕES POR TIPO
        // ==========================================
        function classifyError(msg) {
            if (!msg) return 'Outros';
            for (const [cat, regex] of Object.entries(ERROR_CATEGORIES)) {
                if (regex.test(msg)) return cat;
            }
            return 'Outros';
        }

        function updateDonutChart(data) {
            if (!donutTypeChart) return;

            const counts = {
                'Timeout': 0,
                'Página / Seletor': 0,
                'Autenticação': 0,
                'Regra': 0,
                'Robô / Script': 0,
                'Outros': 0
            };

            // Contagem baseada nos erros e etapas
            data.forEach(d => {
                const cat = classifyError(d.MensagemErro || d.Etapa);
                counts[cat] = (counts[cat] || 0) + 1;
            });

            const labels = Object.keys(counts);
            const vals = Object.values(counts);
            const total = vals.reduce((a, b) => a + b, 0);

            document.getElementById('donut-total-val').innerText = total;

            donutTypeChart.data.labels = labels;
            donutTypeChart.data.datasets[0].data = vals;
            donutTypeChart.update();

            // Atualiza legenda com porcentagens
            const legendEl = document.getElementById('donut-legend');
            let legendHtml = '';
            labels.forEach((lbl, idx) => {
                const val = vals[idx];
                const pct = total > 0 ? ((val / total) * 100).toFixed(1) : '0.0';
                legendHtml += `
                    <div class="legend-item">
                        <span class="legend-label">
                            <span class="legend-dot" style="background:${CATEGORY_COLORS[lbl]};"></span>
                            <span>${lbl}</span>
                        </span>
                        <span class="legend-val">${val} <span style="font-weight:400; color:var(--text-muted); font-size:0.68rem;">(${pct}%)</span></span>
                    </div>
                `;
            });
            legendEl.innerHTML = legendHtml;
        }

        // ==========================================
        // 3. LINE: TEMPO MÉDIO DE EXECUÇÃO
        // ==========================================
        function updateTimeLineChart(data) {
            if (!timeLineChart) return;

            const durs = data.filter(d => d.DuracaoVerificacaoEmMinutos != null).map(d => ({
                robo: d.Robo,
                dur: parseFloat(d.DuracaoVerificacaoEmMinutos),
                date: new Date(d.DataFim || d.DataInicio)
            }));

            if (durs.length === 0) {
                document.getElementById('time-stat-avg').innerText = '0m 00s';
                document.getElementById('time-stat-fastest').innerText = '--';
                document.getElementById('time-stat-slowest').innerText = '--';
                timeLineChart.data.datasets[0].data = [0, 0, 0, 0, 0, 0];
                timeLineChart.update();
                return;
            }

            // Stats gerais
            const avgMinutes = durs.reduce((a, b) => a + b.dur, 0) / durs.length;
            const avgM = Math.floor(avgMinutes);
            const avgS = Math.round((avgMinutes - avgM) * 60);
            document.getElementById('time-stat-avg').innerText = `${avgM}m ${avgS.toString().padStart(2, '0')}s`;

            // Mais rápido & mais lento
            const sortedByDur = [...durs].sort((a, b) => a.dur - b.dur);
            const fastest = sortedByDur[0];
            const slowest = sortedByDur[sortedByDur.length - 1];

            const formatDur = (val) => {
                const m = Math.floor(val);
                const s = Math.round((val - m) * 60);
                return m > 0 ? `${m}m ${s}s` : `${s}s`;
            };

            document.getElementById('time-stat-fastest').innerText = `${formatDur(fastest.dur)} (${fastest.robo || ''})`;
            document.getElementById('time-stat-slowest').innerText = `${formatDur(slowest.dur)} (${slowest.robo || ''})`;

            // Horas agrupadas: 00:00, 04:00, 08:00, 12:00, 16:00, 20:00
            const hourSlots = [0, 4, 8, 12, 16, 20];
            const slotAverages = hourSlots.map(h => {
                const inSlot = durs.filter(item => {
                    const hr = item.date.getHours();
                    return hr >= h && hr < h + 4;
                });
                if (inSlot.length === 0) return (avgMinutes > 0 ? avgMinutes.toFixed(1) : 1.5);
                return (inSlot.reduce((a, b) => a + b.dur, 0) / inSlot.length).toFixed(1);
            });

            timeLineChart.data.datasets[0].data = slotAverages;
            timeLineChart.update();
        }

        // ==========================================
        // 4. STATUS DOS ROBÔS (CARD DIREITO)
        // ==========================================
        function renderRobotsStatusList(data) {
            const listEl = document.getElementById('robots-status-list');
            if (data.length === 0) {
                listEl.innerHTML = '<div style="text-align:center; padding:20px; color:var(--text-muted); font-size:0.82rem;">Nenhum robô encontrado.</div>';
                return;
            }

            // Agrupa por robô
            const byRobo = {};
            data.forEach(d => {
                if (!d.Robo) return;
                if (!byRobo[d.Robo]) byRobo[d.Robo] = [];
                byRobo[d.Robo].push(d);
            });

            const now = new Date();
            let html = '';

            Object.keys(byRobo).sort().forEach(roboName => {
                const execs = byRobo[roboName].sort((a, b) => new Date(b.DataFim || b.DataInicio) - new Date(a.DataFim || a.DataInicio));
                const lastExec = execs[0];
                const total = execs.length;
                const sucessos = execs.filter(e => (e.StatusVerificacao || '').toLowerCase() === 'sucesso').length;
                const erros = total - sucessos;
                const pctSucesso = total > 0 ? Math.round((sucessos / total) * 100) : 100;

                // Checagem de inatividade
                const lastDate = new Date(lastExec.DataFim || lastExec.DataInicio);
                const diffHours = (now - lastDate) / (1000 * 60 * 60);

                let badgeCls = 'badge-success';
                let badgeTxt = 'SUCESSO';

                if (diffHours > alertInactiveHours) {
                    badgeCls = 'badge-warning';
                    badgeTxt = 'PARADO';
                } else if ((lastExec.StatusVerificacao || '').toLowerCase() === 'erro') {
                    if (lastExec.CorrecaoErro && lastExec.CorrecaoErro.trim()) {
                        badgeCls = 'badge-corrigido';
                        badgeTxt = 'CORRIGIDO';
                    } else {
                        badgeCls = 'badge-error';
                        badgeTxt = 'ERRO';
                    }
                }

                html += `
                    <div class="robot-row-item" onclick="openModal(${lastExec.IdLog})">
                        <div class="robot-row-top">
                            <span class="robot-row-name"><i class="fas fa-robot"></i> ${roboName}</span>
                            <span class="robot-badge-pill ${badgeCls}">${badgeTxt}</span>
                        </div>
                        <div class="robot-row-meta">
                            <span>Última: ${lastExec.DataFim ? lastExec.DataFim.substring(11, 16) : '--:--'}</span>
                            <span style="font-weight:600;">${total} exec. (${pctSucesso}%)</span>
                        </div>
                        <div class="robot-row-bar">
                            <div class="robot-bar-fill-success" style="width: ${pctSucesso}%;"></div>
                            <div class="robot-bar-fill-error" style="width: ${100 - pctSucesso}%;"></div>
                        </div>
                    </div>
                `;
            });

            listEl.innerHTML = html;
        }

        // ==========================================
        // 5. ÚLTIMOS ERROS & CLASSIFICAÇÃO
