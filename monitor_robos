            const currentFiltered = getFilteredData();
            let errors = currentFiltered.filter(d => (d.StatusVerificacao || '').toLowerCase() === 'erro');
            
            if (errors.length === 0) {
                errors = allData.filter(d => (d.StatusVerificacao || '').toLowerCase() === 'erro');
            }
            
            if (errors.length === 0) {
                mostrarToast('Nenhum Erro', 'Não há nenhum erro pendente para ser corrigido no momento.', 'info');
                return;
            }
            
            pendingErrorLogsToFix = errors;
            
            const countBadge = document.getElementById('corrigir-todos-count-badge');
            const resumoEl = document.getElementById('corrigir-todos-resumo-robos');
            const inputEl = document.getElementById('corrigir-todos-input');
            
            countBadge.innerText = `${errors.length} erro${errors.length > 1 ? 's' : ''}`;
            
            const countsByRobo = {};
            errors.forEach(e => {
                countsByRobo[e.Robo] = (countsByRobo[e.Robo] || 0) + 1;
            });
            
            let resumoHtml = '<div style="display:flex; flex-direction:column; gap:6px;">';
            Object.entries(countsByRobo).forEach(([robo, qtd]) => {
                resumoHtml += `
                    <div style="display:flex; justify-content:space-between; align-items:center; background:#ffffff; padding:6px 10px; border-radius:6px; border:1px solid #e2e8f0;">
                        <span style="font-weight:600; color:var(--text-primary);"><i class="fas fa-robot" style="color:var(--accent); margin-right:6px;"></i>${robo}</span>
                        <span class="robot-badge-pill badge-error" style="font-size:0.7rem; padding:2px 8px;">${qtd} falha${qtd > 1 ? 's' : ''}</span>
                    </div>
                `;
            });
            resumoHtml += '</div>';
            resumoEl.innerHTML = resumoHtml;
            
            inputEl.value = 'Correção em lote aplicada pelo operador CPD - Falhas verificadas e regularizadas.';
            document.getElementById('modal-corrigir-todos').style.display = 'flex';
        }

        function fecharModalCorrigirTodos() {
            document.getElementById('modal-corrigir-todos').style.display = 'none';
        }

        async function executarCorrigirTodos() {
            if (!pendingErrorLogsToFix || pendingErrorLogsToFix.length === 0) {
                fecharModalCorrigirTodos();
                return;
            }
            
            const btn = document.getElementById('btn-confirmar-corrigir-todos');
            const txt = document.getElementById('corrigir-todos-input').value.trim();
            const ids = pendingErrorLogsToFix.map(e => e.IdLog);
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processando correção...';
            
            try {
                const res = await fetch('/api/monitor_robos/corrigir_todos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ids: ids,
                        correcao: txt
                    })
                });
                
                const result = await res.json();
                
                if (result.status === 'success') {
                    const dataCorrecao = result.data_correcao || new Date().toISOString().replace('T', ' ').substring(0, 19);
                    const correcaoMsg = result.correcao || txt || 'Correção em lote';
                    
                    const updatedSet = new Set((result.updated_ids && result.updated_ids.length > 0) ? result.updated_ids : ids);
                    allData.forEach(item => {
                        if (updatedSet.has(item.IdLog)) {
                            item.StatusVerificacao = 'CORRIGIDO';
                            item.CorrecaoErro = correcaoMsg;
                            item.DataCorrecao = dataCorrecao;
                        }
                    });
                    
                    fecharModalCorrigirTodos();
                    renderAll();
                    mostrarToast('Erros Regularizados!', result.message || `${ids.length} erro(s) corrigido(s) com sucesso!`, 'success');
                    
                    // Sincroniza em background
                    fetchData();
                } else {
                    mostrarToast('Erro ao Corrigir', result.message || 'Falha ao processar correção.', 'error');
                }
            } catch (e) {
                mostrarToast('Erro de Conexão', e.message || 'Falha na comunicação com o servidor.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle"></i> Confirmar e Resolver Todos';
            }
        }

        function mostrarToast(title, message, type = 'info') {
            let container = document.getElementById('cpd-toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'cpd-toast-container';
                container.className = 'cpd-toast-container';
                document.body.appendChild(container);
            }
            
            const toast = document.createElement('div');
            toast.className = `cpd-toast toast-${type}`;
            
            let iconClass = 'fa-info-circle';
            if (type === 'success') iconClass = 'fa-check-circle';
            if (type === 'error') iconClass = 'fa-exclamation-triangle';
            
            toast.innerHTML = `
                <div class="cpd-toast-icon"><i class="fas ${iconClass}"></i></div>
                <div class="cpd-toast-content">
                    <div class="cpd-toast-title">${title}</div>
                    <div class="cpd-toast-message">${message}</div>
                </div>
                <button type="button" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:0.8rem; padding:4px;" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                if (toast && toast.parentElement) {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(10px) scale(0.95)';
                    setTimeout(() => toast.remove(), 300);
                }
            }, 4500);
        }
    </script>
</body>
</html>
