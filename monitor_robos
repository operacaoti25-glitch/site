        function renderReports(data) {
            const tbody = document.getElementById('report-tbody');
            if (!tbody) return;

            const byRobo = {};
            data.forEach(d => {
                if (!d.Robo) return;
                if (!byRobo[d.Robo]) byRobo[d.Robo] = [];
                byRobo[d.Robo].push(d);
            });

            let html = '';
            Object.keys(byRobo).sort().forEach(r => {
                const list = byRobo[r];
                const total = list.length;
                const succ = list.filter(e => (e.StatusVerificacao || '').toLowerCase() === 'sucesso').length;
                const err = list.filter(e => (e.StatusVerificacao || '').toLowerCase() === 'erro').length;
                const corr = list.filter(e => e.CorrecaoErro && e.CorrecaoErro.trim()).length;
                const taxa = total > 0 ? ((succ / total) * 100).toFixed(1) + '%' : '0%';

                const durs = list.filter(e => e.DuracaoVerificacaoEmMinutos != null).map(e => parseFloat(e.DuracaoVerificacaoEmMinutos));
                const avgDur = durs.length ? (durs.reduce((a, b) => a + b, 0) / durs.length).toFixed(1) + 'm' : '--';

                const latest = list.sort((a, b) => new Date(b.DataFim || b.DataInicio) - new Date(a.DataFim || a.DataInicio))[0];

                html += `
                    <tr>
                        <td style="font-weight:700;"><i class="fas fa-robot" style="color:var(--primary); margin-right:6px;"></i> ${r}</td>
                        <td style="font-weight:600;">${total}</td>
                        <td style="color:#059669; font-weight:600;">${succ}</td>
                        <td style="color:#dc2626; font-weight:600;">${err}</td>
                        <td style="color:#15803d; font-weight:600;">${corr}</td>
                        <td><span class="robot-badge-pill badge-success">${taxa}</span></td>
                        <td>${avgDur}</td>
                        <td style="font-size:0.8rem;">${latest ? (latest.DataFim || latest.DataInicio || '--') : '--'}</td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
        }

        function exportDataCSV() {
            const data = getFilteredData();
            if (data.length === 0) {
                alert('Nenhum registro para exportar.');
                return;
            }

            let csv = 'IdLog;Robo;DataInicio;DataFim;DuracaoMinutos;Status;MensagemErro;Etapa;CorrecaoErro;DataCorrecao\r\n';
            data.forEach(r => {
                csv += `"${r.IdLog}";"${r.Robo}";"${r.DataInicio || ''}";"${r.DataFim || ''}";"${r.DuracaoVerificacaoEmMinutos || ''}";"${r.StatusVerificacao || ''}";"${(r.MensagemErro || '').replace(/"/g, '""')}";"${(r.Etapa || '').replace(/"/g, '""')}";"${(r.CorrecaoErro || '').replace(/"/g, '""')}";"${r.DataCorrecao || ''}"\r\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.setAttribute('download', `monitor_robos_e2e_${new Date().toISOString().substring(0, 10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

