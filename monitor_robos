        function openModal(logId) {
            const dataObj = allData.find(d => String(d.IdLog) === String(logId));
            if (!dataObj) {
                console.error("Log não encontrado:", logId);
                return;
            }

            currentModalLogId = dataObj.IdLog;
            document.getElementById('mdl-title').innerText = dataObj.Robo || 'Robô';
            document.getElementById('mdl-id').innerText = '#' + dataObj.IdLog;
            document.getElementById('mdl-inicio').innerText = dataObj.DataInicio || '--';
            document.getElementById('mdl-fim').innerText = dataObj.DataFim || '--';
            document.getElementById('mdl-duracao').innerText = dataObj.DuracaoVerificacaoEmMinutos != null ? `${dataObj.DuracaoVerificacaoEmMinutos} min` : '--';
            document.getElementById('mdl-etapa').innerText = dataObj.Etapa || '--';

            // Comentário / Correção
            document.getElementById('mdl-correcao-input').value = dataObj.CorrecaoErro || '';
            document.getElementById('mdl-correcao-data').innerText = dataObj.DataCorrecao ? `Informado em: ${dataObj.DataCorrecao}` : '';

            // Status Badge & Error Message
            const isErr = (dataObj.StatusVerificacao || '').toLowerCase() === 'erro';
            const hasCorrection = dataObj.CorrecaoErro && dataObj.CorrecaoErro.trim().length > 0;
            const statusEl = document.getElementById('mdl-status');
            const errorBlock = document.getElementById('mdl-error-block');
            const erroEl = document.getElementById('mdl-erro');

            if (hasCorrection) {
                statusEl.className = 'robot-badge-pill badge-corrigido';
                statusEl.innerText = 'CORRIGIDO';
                errorBlock.style.display = 'block';
                erroEl.innerText = dataObj.MensagemErro || 'Erro registrado.';
            } else if (isErr) {
                statusEl.className = 'robot-badge-pill badge-error';
                statusEl.innerText = 'ERRO';
                errorBlock.style.display = 'block';
                erroEl.innerText = dataObj.MensagemErro || 'Erro desconhecido sem mensagem.';
            } else {
                statusEl.className = 'robot-badge-pill badge-success';
                statusEl.innerText = 'SUCESSO';
                errorBlock.style.display = 'none';
            }

            // Screenshot Logic
            const imgEl = document.getElementById('mdl-img');
            const loader = document.getElementById('mdl-img-loader');
            const emptyMsg = document.getElementById('mdl-img-empty');
            const downloadLink = document.getElementById('mdl-screenshot-download');

            imgEl.style.display = 'none';
            emptyMsg.style.display = 'none';
            loader.style.display = 'block';
            downloadLink.style.display = 'none';

            fetch(`/api/robo_screenshot/${dataObj.IdLog}`)
                .then(res => {
                    if (res.ok) return res.blob();
                    throw new Error('No screenshot');
                })
                .then(blob => {
                    const objectURL = URL.createObjectURL(blob);
                    imgEl.src = objectURL;
                    imgEl.style.display = 'block';
                    loader.style.display = 'none';
                    downloadLink.href = objectURL;
                    downloadLink.style.display = 'inline-flex';
                })
                .catch(() => {
                    loader.style.display = 'none';
                    emptyMsg.style.display = 'block';
                });

            document.getElementById('detail-modal').style.display = 'flex';
        }

        async function salvarCorrecaoLog() {
            if (!currentModalLogId) return;
            const txt = document.getElementById('mdl-correcao-input').value.trim();
            const btn = document.getElementById('btn-salvar-correcao');

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';

            try {
                const res = await fetch('/api/monitor_robos/salvar_correcao', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id_log: currentModalLogId, correcao: txt })
                });
                const result = await res.json();
                if (result.status === 'success') {
                    document.getElementById('mdl-correcao-data').innerText = result.data_correcao ? `Informado em: ${result.data_correcao}` : '';
                    const item = allData.find(d => d.IdLog === currentModalLogId);
                    if (item) {
                        item.CorrecaoErro = txt;
                        item.DataCorrecao = result.data_correcao;
                        if (txt) item.StatusVerificacao = 'CORRIGIDO';
                    }
                    renderAll();
                    alert('Comentário / Ação salva com sucesso!');
                } else {
                    alert('Erro ao salvar: ' + (result.message || 'Erro desconhecido'));
                }
            } catch (e) {
                alert('Erro na requisição: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save"></i> Salvar Comentário';
            }
        }

